# Archon lean-runtime preventive controls for synthesized CloudFormation.
# Security is enforced in CI/CD. The rules intentionally reject the retired
# always-on ECS/NLB/VpcLink/EKS topology and validate the zero-idle judge design.

let legacy_resources = Resources.*[
  Type IN [
    'AWS::ECS::Cluster',
    'AWS::ECS::Service',
    'AWS::ECS::TaskDefinition',
    'AWS::EKS::Cluster',
    'AWS::EC2::NatGateway',
    'AWS::ElasticLoadBalancingV2::LoadBalancer',
    'AWS::ApiGateway::VpcLink'
  ]
]

let ecr_repositories = Resources.*[
  Type == 'AWS::ECR::Repository'
]

let vpcs = Resources.*[
  Type == 'AWS::EC2::VPC'
]

let vpc_flow_logs = Resources.*[
  Type == 'AWS::EC2::FlowLog'
]

let buckets = Resources.*[
  Type == 'AWS::S3::Bucket'
]

let state_buckets = %buckets[
  Properties.AccessControl not exists
]

let acl_buckets = %buckets[
  Properties.AccessControl exists
]

let access_log_buckets = %buckets[
  Properties.AccessControl == 'LogDeliveryWrite'
]

let kms_acl_log_buckets = %state_buckets[
  Properties.OwnershipControls.Rules[*].ObjectOwnership == 'ObjectWriter'
]

let keys = Resources.*[
  Type == 'AWS::KMS::Key'
]

let roles = Resources.*[
  Type == 'AWS::IAM::Role'
]

let logs = Resources.*[
  Type == 'AWS::Logs::LogGroup'
]

let tables = Resources.*[
  Type == 'AWS::DynamoDB::Table'
]

let queues = Resources.*[
  Type == 'AWS::SQS::Queue'
]

let lambda_functions = Resources.*[
  Type == 'AWS::Lambda::Function'
]

let image_functions = %lambda_functions[
  Properties.PackageType == 'Image'
]

let api_stages = Resources.*[
  Type == 'AWS::ApiGateway::Stage'
]

let distributions = Resources.*[
  Type == 'AWS::CloudFront::Distribution'
]

let oacs = Resources.*[
  Type == 'AWS::CloudFront::OriginAccessControl'
]

let web_acls = Resources.*[
  Type == 'AWS::WAFv2::WebACL'
]

let waf_logs = Resources.*[
  Type == 'AWS::WAFv2::LoggingConfiguration'
]

let user_pools = Resources.*[
  Type == 'AWS::Cognito::UserPool'
]

let user_pool_clients = Resources.*[
  Type == 'AWS::Cognito::UserPoolClient'
]

let secrets = Resources.*[
  Type == 'AWS::SecretsManager::Secret'
]

let launch_templates = Resources.*[
  Type == 'AWS::EC2::LaunchTemplate'
]

let auto_scaling_groups = Resources.*[
  Type == 'AWS::AutoScaling::AutoScalingGroup'
]

let state_machines = Resources.*[
  Type == 'AWS::StepFunctions::StateMachine'
]

rule retired_always_on_topology_is_absent {
  let legacy_count = count(%legacy_resources)
  %legacy_count == 0
}

rule every_vpc_emits_all_traffic_to_cloudwatch when %vpcs !empty {
  let vpc_count = count(%vpcs)
  let flow_log_count = count(%vpc_flow_logs)
  %vpc_count == 1
  %flow_log_count == 1
  %vpc_flow_logs.Properties {
    DeliverLogsPermissionArn exists
    LogGroupName exists
    LogDestinationType == 'cloud-watch-logs'
    MaxAggregationInterval == 600
    ResourceId exists
    ResourceType == 'VPC'
    TrafficType == 'ALL'
  }
}

rule ecr_release_registries_are_immutable when %ecr_repositories !empty {
  %ecr_repositories.Properties {
    ImageTagMutability == 'IMMUTABLE'
    ImageScanningConfiguration.ScanOnPush == true
    EncryptionConfiguration.EncryptionType == 'KMS'
    EncryptionConfiguration.KmsKey exists
  }
}

rule s3_state_is_private_versioned_and_encrypted when %state_buckets !empty {
  %state_buckets.Properties {
    PublicAccessBlockConfiguration {
      BlockPublicAcls == true
      BlockPublicPolicy == true
      IgnorePublicAcls == true
      RestrictPublicBuckets == true
    }
    VersioningConfiguration.Status == 'Enabled'
    BucketEncryption.ServerSideEncryptionConfiguration !empty
    BucketEncryption.ServerSideEncryptionConfiguration[*] {
      BucketKeyEnabled == true
      ServerSideEncryptionByDefault.SSEAlgorithm == 'aws:kms'
      ServerSideEncryptionByDefault.KMSMasterKeyID exists
    }
  }
}

rule only_the_reviewed_terminal_sink_may_enable_bucket_acls when %acl_buckets !empty {
  let acl_bucket_count = count(%acl_buckets)
  let access_log_bucket_count = count(%access_log_buckets)
  %acl_bucket_count == %access_log_bucket_count
}

rule cloudfront_log_bucket_is_kms_encrypted_and_forwards_access_logs when %kms_acl_log_buckets !empty {
  let kms_acl_log_bucket_count = count(%kms_acl_log_buckets)
  %kms_acl_log_bucket_count == 1
  %kms_acl_log_buckets.Properties {
    AccessControl not exists
    LoggingConfiguration {
      DestinationBucketName exists
      LogFilePrefix == /^(staging|production)\/s3\/cloudfront-log-bucket\/$/
    }
    OwnershipControls.Rules[*].ObjectOwnership == 'ObjectWriter'
    some LifecycleConfiguration.Rules[*] {
      Status == 'Enabled'
      AbortIncompleteMultipartUpload.DaysAfterInitiation <= 1
      ExpirationInDays <= 180
      NoncurrentVersionExpiration.NoncurrentDays <= 30
    }
    some Tags[*] {
      Key == 'SecurityProfile'
      Value == 'cloudfront-access-log-bucket'
    }
  }
}

rule terminal_s3_access_log_sink_is_bounded when %access_log_buckets !empty {
  let access_log_bucket_count = count(%access_log_buckets)
  %access_log_bucket_count == 1
  %access_log_buckets.Properties {
    AccessControl == 'LogDeliveryWrite'
    LoggingConfiguration not exists
    PublicAccessBlockConfiguration {
      BlockPublicAcls == true
      BlockPublicPolicy == true
      IgnorePublicAcls == true
      RestrictPublicBuckets == true
    }
    OwnershipControls.Rules[*].ObjectOwnership == 'ObjectWriter'
    VersioningConfiguration.Status == 'Enabled'
    BucketEncryption.ServerSideEncryptionConfiguration !empty
    BucketEncryption.ServerSideEncryptionConfiguration[*] {
      BucketKeyEnabled not exists
      ServerSideEncryptionByDefault {
        SSEAlgorithm == 'AES256'
        KMSMasterKeyID not exists
      }
    }
    some LifecycleConfiguration.Rules[*] {
      Status == 'Enabled'
      AbortIncompleteMultipartUpload.DaysAfterInitiation <= 1
      ExpirationInDays <= 180
      NoncurrentVersionExpiration.NoncurrentDays <= 30
    }
    some Tags[*] {
      Key == 'SecurityProfile'
      Value == 'terminal-access-log-sink'
    }
  }
}

rule kms_keys_rotate_and_are_not_immediately_deletable when %keys !empty {
  %keys.Properties {
    PendingWindowInDays >= 7
    KeyPolicy exists
    KeyUsage not exists or
    KeyUsage IN ['ENCRYPT_DECRYPT', 'SIGN_VERIFY']

    # AWS KMS automatic rotation supports symmetric encryption keys, not
    # asymmetric signing keys. Keep the ordinary CMKs on automatic rotation.
    when KeyUsage not exists {
      KeySpec not exists or
      KeySpec == 'SYMMETRIC_DEFAULT'
      EnableKeyRotation == true
    }
    when KeyUsage == 'ENCRYPT_DECRYPT' {
      KeySpec not exists or
      KeySpec == 'SYMMETRIC_DEFAULT'
      EnableKeyRotation == true
    }

    # Archon's off-host mutation authorization deliberately uses a public-key
    # verifier. Rotation is alias-based/manual and the key is retained.
    when KeyUsage == 'SIGN_VERIFY' {
      KeySpec == 'ECC_NIST_P256'
      EnableKeyRotation not exists
    }
  }
}

rule every_runtime_role_has_the_stage_boundary when %roles !empty {
  %roles.Properties.PermissionsBoundary exists
}

rule retained_logs_are_kms_encrypted when %logs !empty {
  %logs.Properties {
    KmsKeyId exists
    RetentionInDays >= 365
  }
}

rule dynamodb_state_is_resilient when %tables !empty {
  %tables.Properties {
    BillingMode == 'PAY_PER_REQUEST'
    DeletionProtectionEnabled == true
    PointInTimeRecoverySpecification.PointInTimeRecoveryEnabled == true
    SSESpecification {
      SSEEnabled == true
      SSEType == 'KMS'
      KMSMasterKeyId exists
    }
  }
}

rule failure_queues_are_customer_key_encrypted when %queues !empty {
  %queues.Properties {
    KmsMasterKeyId exists
    MessageRetentionPeriod >= 1209600
  }
}

rule lambdas_are_bounded_observable_and_not_vpc_attached
  when %lambda_functions !empty {
  %lambda_functions.Properties {
    ReservedConcurrentExecutions >= 1
    TracingConfig.Mode == 'Active'
    VpcConfig not exists
  }
}

rule cloud_runtime_images_are_digest_parameter_bound
  when %image_functions !empty {
  %image_functions.Properties {
    Architectures == ['x86_64']
    Code.ImageUri.Ref == 'CloudRuntimeImageUri'
    ImageConfig.Command !empty
    EphemeralStorage.Size >= 512
    Timeout <= 900
  }
}

rule api_stages_are_traced_throttled_and_non_verbose when %api_stages !empty {
  %api_stages.Properties {
    AccessLogSetting.DestinationArn exists
    AccessLogSetting.Format exists
    CacheClusterEnabled == false
    TracingEnabled == true
    MethodSettings !empty
    MethodSettings[*] {
      DataTraceEnabled == false
      MetricsEnabled == true
      ThrottlingBurstLimit > 0
      ThrottlingRateLimit > 0
    }
  }
}

rule cloudfront_uses_oac_custom_tls_and_waf when %distributions !empty {
  let distribution_count = count(%distributions)
  let oac_count = count(%oacs)
  %distribution_count == 1
  %oac_count == 1
  %distributions.Properties.DistributionConfig {
    Enabled == true
    WebACLId exists
    Aliases !empty
    Logging {
      Bucket exists
      IncludeCookies == false
      Prefix == /^(staging|production)\/cloudfront\/$/
    }
    ViewerCertificate {
      AcmCertificateArn exists
      CloudFrontDefaultCertificate not exists
      MinimumProtocolVersion == 'TLSv1.3_2025'
      SslSupportMethod == 'sni-only'
    }
    DefaultCacheBehavior {
      ViewerProtocolPolicy IN ['redirect-to-https', 'https-only']
      FunctionAssociations !empty
      ResponseHeadersPolicyId exists
    }
    CacheBehaviors[*] {
      ViewerProtocolPolicy == 'https-only'
      FunctionAssociations !empty
      ResponseHeadersPolicyId exists
    }
    some Origins[*] {
      OriginAccessControlId exists
    }
  }
  %oacs.Properties.OriginAccessControlConfig {
    OriginAccessControlOriginType == 's3'
    SigningBehavior == 'always'
    SigningProtocol == 'sigv4'
  }
}

rule waf_never_logs_authentication_material
  when %waf_logs !empty {
  %waf_logs.Properties {
    LoggingFilter.DefaultBehavior == 'DROP'
    RedactedFields !empty
    some RedactedFields[*] {
      SingleHeader.Name == 'authorization'
    }
    some RedactedFields[*] {
      SingleHeader.Name == 'cookie'
    }
    some RedactedFields[*] {
      SingleHeader.Name == 'x-api-key'
    }
  }
}

rule waf_acls_fail_closed_on_sensitive_fields when %web_acls !empty {
  %web_acls.Properties {
    Scope IN ['REGIONAL', 'CLOUDFRONT']
    VisibilityConfig.SampledRequestsEnabled == false
    Rules !empty
    Rules[*].VisibilityConfig.SampledRequestsEnabled == false
  }
}

rule cognito_is_admin_created_and_threat_protected
  when %user_pools !empty {
  %user_pools.Properties {
    AdminCreateUserConfig.AllowAdminCreateUserOnly == true
    DeletionProtection == 'ACTIVE'
    MfaConfiguration == 'OPTIONAL'
    EnabledMfas == ['SOFTWARE_TOKEN_MFA']
    Policies.PasswordPolicy {
      MinimumLength >= 14
      PasswordHistorySize >= 24
      TemporaryPasswordValidityDays <= 3
    }
    UserPoolAddOns.AdvancedSecurityMode == 'ENFORCED'
  }
}

rule cognito_public_clients_use_short_lived_tokens
  when %user_pool_clients !empty {
  %user_pool_clients.Properties {
    GenerateSecret == false
    PreventUserExistenceErrors == 'ENABLED'
    AccessTokenValidity <= 15
    IdTokenValidity <= 15
    RefreshTokenValidity <= 1
  }
}

rule secrets_are_customer_key_encrypted when %secrets !empty {
  %secrets.Properties.KmsKeyId exists
}

rule core_launch_templates_require_imdsv2
  when %launch_templates !empty {
  %launch_templates.Properties.LaunchTemplateData {
    MetadataOptions {
      HttpEndpoint == 'enabled'
      HttpTokens == 'required'
    }
    NetworkInterfaces[*].AssociatePublicIpAddress == false
    BlockDeviceMappings[*].Ebs.Encrypted == true
  }
}

rule core_is_zero_idle_single_host
  when %auto_scaling_groups !empty {
  %auto_scaling_groups.Properties {
    MinSize == '0'
    DesiredCapacity == '0'
    MaxSize == '1'
  }
}

rule core_lifecycle_is_traced_and_logged
  when %state_machines !empty {
  %state_machines.Properties {
    TracingConfiguration.Enabled == true
    LoggingConfiguration.Level == 'ALL'
    LoggingConfiguration.IncludeExecutionData == false
  }
}
