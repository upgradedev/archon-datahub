{
  "schemaVersion": "archon.aws-foundation/v1",
  "repository": "upgradedev/archon-datahub",
  "defaultBranch": "master",
  "workflow": {
    "path": ".github/workflows/aws-foundation.yml",
    "environment": "aws-foundation",
    "confirmation": "BOOTSTRAP_CDK_FOUNDATION"
  },
  "aws": {
    "partition": "aws",
    "accountVariable": "AWS_ACCOUNT_ID",
    "primaryRegionVariable": "AWS_REGION",
    "primaryRegion": "eu-west-1",
    "regions": [
      "eu-west-1",
      "us-east-1"
    ],
    "foundationRoleVariable": "AWS_FOUNDATION_ROLE_ARN",
    "foundationRoleName": "archon-datahub-github-foundation",
    "foundationRoleAdoption": {
      "knownLegacyDescription": "GitHub OIDC role for the Archon DataHub CDK foundation bootstrap pipeline",
      "knownLegacyTags": {
        "Application": "archon-datahub",
        "Environment": "foundation",
        "ManagedBy": "github-actions"
      },
      "knownLegacyTrustDifference": "missing-canonical-sid-only",
      "requiresZeroInlinePolicies": true,
      "requiresZeroAttachedManagedPolicies": true,
      "allowsOnlyLegacyOrCanonicalComponentsForInterruptedRetry": true,
      "convergesToCanonicalRole": true
    },
    "foundationPolicies": {
      "sourceBundle": "infra/aws/foundation/github-actions-foundation-policy.json",
      "sourceBundleAttachable": false,
      "renderer": "scripts/render-aws-foundation-policy.mjs",
      "maximumDocumentBytes": 6144,
      "roleInlinePolicyCount": 0,
      "roleAttachedPolicyCount": 4,
      "roleManagedPolicyQuota": 10,
      "roleManagedPolicyHeadroom": 6,
      "attachedPolicyNames": [
        "archon-aws-foundation-control",
        "archon-aws-foundation-assets",
        "archon-aws-foundation-identity",
        "archon-aws-foundation-attachments"
      ]
    },
    "sharedApiGatewayLogging": {
      "stackName": "Archon-Shared-ApiGateway-Logging",
      "region": "eu-west-1",
      "roleName": "archon-datahub-apigateway-cloudwatch-logs",
      "inlinePolicyName": "archon-apigateway-cloudwatch-logs"
    },
    "deployRoles": {
      "staging": {
        "roleName": "archon-datahub-github-staging-deploy",
        "stackName": "Archon-GitHub-Staging-Deploy-Role"
      },
      "production": {
        "roleName": "archon-datahub-github-production-deploy",
        "stackName": "Archon-GitHub-Production-Deploy-Role"
      }
    },
    "governedCanaryRoles": {
      "stackName": "Archon-Governed-Canary-Roles",
      "region": "eu-west-1",
      "roles": {
        "prepare": {
          "environment": "governed-canary-prepare",
          "roleName": "archon-datahub-github-governed-canary-prepare",
          "variable": "AWS_CANARY_PREPARE_ROLE_ARN",
          "permissions": [
            "cloudformation:DescribeStacks"
          ]
        },
        "approval": {
          "environment": "governed-canary",
          "roleName": "archon-datahub-github-governed-canary-approval",
          "variable": "AWS_CANARY_APPROVAL_ROLE_ARN",
          "permissions": [
            "cloudformation:DescribeStacks",
            "cognito-idp:AdminGetUser",
            "cognito-idp:AdminListGroupsForUser"
          ]
        },
        "recovery": {
          "environment": "governed-canary-recovery",
          "roleName": "archon-datahub-github-governed-canary-recovery",
          "variable": "AWS_CANARY_RECOVERY_ROLE_ARN",
          "permissions": [
            "cloudformation:DescribeStacks"
          ]
        }
      }
    },
    "privateLink": {
      "region": "eu-west-1",
      "privateDnsEnabled": true,
      "serviceOwnerMustDifferFromDeploymentAccount": true,
      "executionPolicyFamily": "endpoint",
      "ec2Actions": [
        "ec2:CreateTags",
        "ec2:CreateVpcEndpoint",
        "ec2:DeleteTags",
        "ec2:DeleteVpcEndpoints",
        "ec2:DescribeVpcEndpointServices",
        "ec2:DescribeVpcEndpoints",
        "ec2:ModifyVpcEndpoint"
      ],
      "route53Actions": [
        "route53:AssociateVPCWithHostedZone"
      ],
      "route53VpcCondition": "VPCId=vpc-*,VPCRegion=eu-west-1",
      "route53VpcArnConditionAllowed": false,
      "disassociateVpcFromHostedZoneAllowed": false
    },
    "stages": {
      "staging": {
        "bootstrapStackName": "CDKToolkit-archonstg",
        "qualifier": "archonstg",
        "executionPolicyNames": [
          "archon-datahub-cdk-guard-staging",
          "archon-datahub-cdk-identity-staging",
          "archon-datahub-cdk-data-staging",
          "archon-datahub-cdk-state-staging",
          "archon-datahub-cdk-observability-staging",
          "archon-datahub-cdk-compute-staging",
          "archon-datahub-cdk-network-staging",
          "archon-datahub-cdk-endpoint-staging",
          "archon-datahub-cdk-delivery-staging",
          "archon-datahub-cdk-edge-staging"
        ],
        "executionPolicyAttachments": {
          "eu-west-1": [
            "guard",
            "identity",
            "data",
            "state",
            "observability",
            "compute",
            "network",
            "endpoint",
            "delivery"
          ],
          "us-east-1": [
            "guard",
            "edge"
          ]
        },
        "runtimeBoundaryName": "archon-datahub-runtime-boundary-staging",
        "iamFoundationStackName": "Archon-Staging-IAM-Foundation"
      },
      "production": {
        "bootstrapStackName": "CDKToolkit-archonprd",
        "qualifier": "archonprd",
        "executionPolicyNames": [
          "archon-datahub-cdk-guard-production",
          "archon-datahub-cdk-identity-production",
          "archon-datahub-cdk-data-production",
          "archon-datahub-cdk-state-production",
          "archon-datahub-cdk-observability-production",
          "archon-datahub-cdk-compute-production",
          "archon-datahub-cdk-network-production",
          "archon-datahub-cdk-endpoint-production",
          "archon-datahub-cdk-delivery-production",
          "archon-datahub-cdk-edge-production"
        ],
        "executionPolicyAttachments": {
          "eu-west-1": [
            "guard",
            "identity",
            "data",
            "state",
            "observability",
            "compute",
            "network",
            "endpoint",
            "delivery"
          ],
          "us-east-1": [
            "guard",
            "edge"
          ]
        },
        "runtimeBoundaryName": "archon-datahub-runtime-boundary-production",
        "iamFoundationStackName": "Archon-Production-IAM-Foundation"
      }
    },
    "bootstrap": {
      "minimumVersion": 6,
      "pinnedVersion": 32,
      "terminationProtection": true,
      "customerManagedKey": false
    },
    "runtimeBoundary": {
      "schemaVersion": "archon.aws-runtime-boundary/v1",
      "policyNameTemplate": "archon-datahub-runtime-boundary-<stage>",
      "allowedActions": [
        "bedrock-mantle:CallWithBearerToken",
        "bedrock-mantle:CreateInference",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:TransactWriteItems",
        "dynamodb:UpdateItem",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:DescribeSecurityGroups",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetAuthorizationToken",
        "ecr:GetDownloadUrlForLayer",
        "kms:Decrypt",
        "kms:Describe*",
        "kms:Encrypt",
        "kms:GenerateDataKey*",
        "kms:ReEncrypt*",
        "logs:CreateLogDelivery",
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:DeleteLogDelivery",
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:DescribeResourcePolicies",
        "logs:GetLogDelivery",
        "logs:ListLogDeliveries",
        "logs:PutLogEvents",
        "logs:PutResourcePolicy",
        "logs:UpdateLogDelivery",
        "s3:GetObject",
        "s3:GetObjectAttributes",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue",
        "sns:Publish",
        "sqs:ChangeMessageVisibility",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ReceiveMessage",
        "sqs:SendMessage",
        "states:DescribeExecution",
        "states:SendTaskFailure",
        "states:SendTaskHeartbeat",
        "states:SendTaskSuccess",
        "states:StartExecution",
        "xray:GetSamplingRules",
        "xray:GetSamplingTargets",
        "xray:PutTelemetryRecords",
        "xray:PutTraceSegments"
      ],
      "approvedAwsManagedPolicies": {
        "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole": [
          "logs:CreateLogGroup",
          "logs:CreateLogStream",
          "logs:PutLogEvents"
        ],
        "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy": [
          "ecr:BatchCheckLayerAvailability",
          "ecr:BatchGetImage",
          "ecr:GetAuthorizationToken",
          "ecr:GetDownloadUrlForLayer",
          "logs:CreateLogStream",
          "logs:PutLogEvents"
        ]
      }
    }
  },
  "oidc": {
    "providerHost": "token.actions.githubusercontent.com",
    "audience": "sts.amazonaws.com",
    "foundationSubject": "repo:upgradedev/archon-datahub:environment:aws-foundation",
    "deploySubjects": [
      "repo:upgradedev/archon-datahub:environment:production",
      "repo:upgradedev/archon-datahub:environment:staging"
    ],
    "governedCanarySubjects": [
      "repo:upgradedev/archon-datahub:environment:governed-canary-prepare",
      "repo:upgradedev/archon-datahub:environment:governed-canary",
      "repo:upgradedev/archon-datahub:environment:governed-canary-recovery"
    ]
  },
  "evidence": {
    "schemaVersion": "archon.aws-foundation-evidence/v1",
    "predicateType": "https://github.com/upgradedev/archon-datahub/attestations/aws-foundation/v1",
    "artifactRetentionDays": 90,
    "containsRawAccountId": false,
    "containsRawRoleArn": false,
    "applicationStackRolePreflight": {
      "entryCount": 5,
      "allowedEntryValidations": [
        "passed",
        "requires-explicit-deploy-migration"
      ],
      "readyState": "ready-for-deploy",
      "migrationRequiredState": "foundation-complete-deploy-migration-required",
      "deployFinalPostcheckRequiresExactBindings": true
    }
  }
}
