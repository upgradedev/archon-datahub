{
  "hosting": {
    "site": "archon-datahub",
    "public": "web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "run": { "serviceId": "archon-datahub-api", "region": "europe-west1" }
      },
      {
        "source": "/healthz",
        "run": { "serviceId": "archon-datahub-api", "region": "europe-west1" }
      },
      {
        "source": "/readyz",
        "run": { "serviceId": "archon-datahub-api", "region": "europe-west1" }
      },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
