# Copy this file to .env. Docker Compose reads .env automatically.
# The customer quickstart intentionally accepts only an authenticated HTTPS DataHub.
DATAHUB_GMS_URL=https://datahub.example.com
DATAHUB_GMS_TOKEN=replace-with-a-least-privilege-read-token
ARCHON_DEMO_QUERY=urn:li:dataset:(urn:li:dataPlatform:snowflake,example,PROD)

# Optional local binding and evidence label.
ARCHON_PORT=8080
ARCHON_RELEASE_SHA=local
